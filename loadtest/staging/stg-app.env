# 与 deploy/compose.production.yml 的 backend-common + provider 环境一致（去掉密钥、SMTP、出口代理），压测用。
POLARIS_ENVIRONMENT=development
POLARIS_AUTH_MODE=external
POLARIS_DATABASE_POOL_SIZE=3
POLARIS_DATABASE_MAX_OVERFLOW=2
POLARIS_DATABASE_POOL_TIMEOUT_SECONDS=5
POLARIS_DATABASE_POOL_RECYCLE_SECONDS=1800
POLARIS_AUTO_CREATE_SCHEMA=false
POLARIS_STORAGE_BACKEND=s3
POLARIS_S3_ENDPOINT_URL=http://minio:9000
POLARIS_S3_REGION=us-east-1
POLARIS_S3_BUCKET=polaris-assets
POLARIS_S3_AUTO_CREATE_BUCKET=true
POLARIS_ASSET_ACCESS_URL_MODE=same_origin
POLARIS_ECOMMERCE_PROXY_ENABLED=false
POLARIS_ECOMMERCE_LOGIN_ENABLED=false
POLARIS_ECOMMERCE_STARTUP_RECOVERY_ENABLED=false
POLARIS_ECOMMERCE_SESSION_DIR=/app/.data/ecommerce-session/domestic-taobao-tmall
POLARIS_ECOMMERCE_1688_SESSION_DIR=/app/.data/ecommerce-session/domestic-1688
POLARIS_ECOMMERCE_JD_SESSION_DIR=/app/.data/ecommerce-session/domestic-jd
POLARIS_ECOMMERCE_PINDUODUO_SESSION_DIR=/app/.data/ecommerce-session/domestic-pinduoduo
POLARIS_AURORA_WORK_ROOT=/app/.data/aurora-main-image
POLARIS_AURORA_EXECUTION_MODE=sequential_v20
POLARIS_SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
POLARIS_SUPERTOKENS_API_DOMAIN=http://127.0.0.1:3410
POLARIS_SUPERTOKENS_WEBSITE_DOMAIN=http://127.0.0.1:3410
POLARIS_SUPERTOKENS_API_BASE_PATH=/api/auth
POLARIS_SUPERTOKENS_WEBSITE_BASE_PATH=/auth
POLARIS_SUPERTOKENS_COOKIE_SECURE=false
POLARIS_SUPERTOKENS_COOKIE_SAME_SITE=lax
POLARIS_ANNOUNCEMENT_ADMIN_EMAILS=["admin@loadtest.invalid"]
POLARIS_AUTO_PROCESS_JOBS=false
POLARIS_TASK_DISPATCHER=celery
POLARIS_MAX_UPLOAD_BYTES=20971520
POLARIS_MAX_IMAGE_PIXELS=40000000
POLARIS_RETENTION_ENABLED=false
POLARIS_CORS_ORIGINS=["http://127.0.0.1:3410"]
# provider 环境：mock 执行器 + stg_boot 注入的延迟；所有地址指向不存在的本地端口，且没有任何 key
POLARIS_TASK_RUNNER=mock
POLARIS_MOCK_JOB_DELAY_SECONDS=0.35
POLARIS_PROVIDER_QUOTA_ENABLED=true
POLARIS_WORKSPACE_CREDIT_ENFORCEMENT_ENABLED=false
POLARIS_REFERENCE_REMIX_PROVIDER_ENABLED=true
POLARIS_TENGLI_BASE_URL=http://127.0.0.1:9
POLARIS_ANALYSIS_BASE_URL=http://127.0.0.1:9
POLARIS_IMAGE_BASE_URL=http://127.0.0.1:9
POLARIS_PROVIDER_FAILOVER_BASE_URL=http://127.0.0.1:9
POLARIS_VIDEO_SCRIPT_BASE_URL=http://127.0.0.1:9
POLARIS_XINGHE_CONCURRENCY=6
POLARIS_IMAGE_GLOBAL_CONCURRENCY=3000
POLARIS_VIDEO_MEDIA_DIR=/app/.data/video-studio
POLARIS_VIDEO_EDITING_TASKS_DIR=/app/.data/editing-tasks
POLARIS_STORAGE_DIR=/app/.data/storage
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=*
STG_VIDEO_GATE_OPEN=1
# 视频供应商：开关打开，但 VideoProviders 的 httpx 传输层被 stg_boot 换成进程内假实现（MockTransport），以下只是占位值
POLARIS_VIDEO_PROVIDERS_ENABLED=true
POLARIS_QUANYU_API_KEY=staging-fake-no-network
STG_SHIM_AUTOPATCH=1
