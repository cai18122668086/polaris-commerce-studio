# Copy this template to /etc/polaris/polaris.env on the server.
# The real file must be owned by root, mode 600, and must never enter Git.

POLARIS_POSTGRES_PASSWORD=<REPLACE_WITH_RANDOM_POSTGRES_PASSWORD>
POLARIS_REDIS_PASSWORD=<REPLACE_WITH_RANDOM_REDIS_PASSWORD>
POLARIS_MINIO_ROOT_USER=<REPLACE_WITH_RANDOM_MINIO_USER>
POLARIS_MINIO_ROOT_PASSWORD=<REPLACE_WITH_RANDOM_MINIO_PASSWORD>
POLARIS_S3_BUCKET=<REPLACE_WITH_PRIVATE_BUCKET_NAME>
POLARIS_ACCESS_URL_SECRET=<REPLACE_WITH_LONG_RANDOM_SIGNING_SECRET>

POLARIS_DEVELOPMENT_USER_ID=<REPLACE_WITH_INTERNAL_USER_ID>
POLARIS_DEVELOPMENT_WORKSPACE_ID=<REPLACE_WITH_INTERNAL_WORKSPACE_ID>
POLARIS_DEVELOPMENT_WORKSPACE_NAME=<REPLACE_WITH_INTERNAL_WORKSPACE_NAME>

POLARIS_TENGLI_API_KEY=<REPLACE_WITH_BACKEND_ONLY_TENGLI_API_KEY>
POLARIS_TENGLI_BASE_URL=<REPLACE_WITH_HTTPS_PROVIDER_BASE_URL>
POLARIS_TENGLI_IMAGE_MODEL=<REPLACE_WITH_APPROVED_IMAGE_MODEL>
POLARIS_TENGLI_VISION_MODEL=<REPLACE_WITH_APPROVED_PLANNER_MODEL>
POLARIS_TENGLI_SMOKE_BUDGET_USD=<SET_DECIMAL_AT_OR_BELOW_2>
