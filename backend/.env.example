POLARIS_ENVIRONMENT=development
POLARIS_AUTH_MODE=development
# SuperTokens is used when POLARIS_AUTH_MODE=external.
POLARIS_SUPERTOKENS_CONNECTION_URI=http://localhost:3567
POLARIS_SUPERTOKENS_API_KEY=replace-with-a-long-core-api-key
POLARIS_SUPERTOKENS_API_DOMAIN=http://localhost:3000
POLARIS_SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000
POLARIS_SUPERTOKENS_API_BASE_PATH=/api/auth
POLARIS_SUPERTOKENS_WEBSITE_BASE_PATH=/auth
POLARIS_SUPERTOKENS_COOKIE_SECURE=false
POLARIS_SUPERTOKENS_COOKIE_SAME_SITE=lax
# Standard SMTP settings shared by verification and password-reset emails.
# Production external auth requires all host/username/password/from fields.
POLARIS_AUTH_SMTP_HOST=smtp.example.com
POLARIS_AUTH_SMTP_PORT=587
POLARIS_AUTH_SMTP_USERNAME=replace-with-smtp-username
POLARIS_AUTH_SMTP_PASSWORD=replace-with-smtp-password
POLARIS_AUTH_SMTP_SECURE=false
POLARIS_AUTH_EMAIL_FROM_NAME=Polaris Commerce Studio
POLARIS_AUTH_EMAIL_FROM_ADDRESS=no-reply@mail.tengliapi.xyz
POLARIS_DEVELOPMENT_USER_ID=usr_development
POLARIS_DEVELOPMENT_WORKSPACE_ID=ws_development
POLARIS_DEVELOPMENT_WORKSPACE_NAME=开发工作区
POLARIS_ACCESS_URL_SECRET=replace-with-a-long-random-secret
POLARIS_DATABASE_URL=postgresql+psycopg://polaris:polaris_dev_only@localhost:5432/polaris
POLARIS_AUTO_CREATE_SCHEMA=false
POLARIS_STORAGE_DIR=backend/.data/storage
POLARIS_STORAGE_BACKEND=s3
POLARIS_S3_ENDPOINT_URL=http://localhost:9000
POLARIS_S3_REGION=us-east-1
POLARIS_S3_ACCESS_KEY=polaris_minio
POLARIS_S3_SECRET_KEY=polaris_minio_dev_only
POLARIS_S3_BUCKET=polaris-assets
POLARIS_S3_AUTO_CREATE_BUCKET=true
POLARIS_ASSET_ACCESS_URL_MODE=auto
POLARIS_AUTO_PROCESS_JOBS=true
POLARIS_TASK_DISPATCHER=celery
POLARIS_TASK_RUNNER=mock
# Keep true when real Provider execution is enabled so usage/cost ledgers remain active.
POLARIS_PROVIDER_QUOTA_ENABLED=false
# Internal beta: keep membership-style workspace credit enforcement disabled.
POLARIS_WORKSPACE_CREDIT_ENFORCEMENT_ENABLED=false
POLARIS_MOCK_JOB_DELAY_SECONDS=0.35
POLARIS_PRODUCT_IMAGE_PROVIDER_ENABLED=false
POLARIS_REFERENCE_REMIX_PROVIDER_ENABLED=false
POLARIS_MODEL_POSE_TRANSFER_PROVIDER_ENABLED=false
POLARIS_CREATIVE_IMAGE_PROVIDER_ENABLED=false
POLARIS_AMAZON_VISUAL_SUITE_PROVIDER_ENABLED=false
POLARIS_DOMESTIC_MAIN_IMAGE_PROVIDER_ENABLED=false
POLARIS_CROSSBORDER_DETAIL_PROVIDER_ENABLED=false
POLARIS_TENGLI_API_KEY=replace-with-local-backend-only-key
POLARIS_TENGLI_BASE_URL=https://api.tengliapi.xyz:8443
POLARIS_TENGLI_IMAGE_MODEL=gpt-image-2
POLARIS_TENGLI_VISION_MODEL=gpt-5.6-terra
# Technical per-job safety envelope; recurring membership quotas remain disabled below.
POLARIS_TENGLI_SMOKE_BUDGET_USD=200
# Internal beta: 0 means unlimited while usage/cost ledger records remain enabled.
POLARIS_TENGLI_DAILY_BUDGET_USD=0
POLARIS_TENGLI_MONTHLY_BUDGET_USD=0
POLARIS_TENGLI_DAILY_REQUEST_LIMIT=0
POLARIS_TENGLI_PLANNER_RESERVE_MICROS=250000
POLARIS_XINGHE_CONCURRENCY=6
POLARIS_XINGHE_MEDIUM_PRICE_MICROS=45000
POLARIS_XINGHE_HIGH_PRICE_MICROS=90000
# Optional override. The packaged default is backend/skill_sources/xinghe-ecommerce-detail.
POLARIS_XINGHE_SKILL_ROOT=backend/skill_sources/xinghe-ecommerce-detail
# Durable workspace for Aurora identity locks, compiled execution contracts,
# generation attempts, audits, and repair evidence.
POLARIS_AURORA_WORK_ROOT=backend/.data/aurora-main-image
POLARIS_CELERY_BROKER_URL=redis://localhost:6379/0
POLARIS_CELERY_RESULT_BACKEND=redis://localhost:6379/1
POLARIS_MAX_UPLOAD_BYTES=20971520
POLARIS_MAX_IMAGE_PIXELS=40000000
POLARIS_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
