# Local frontend preview. Production should omit this flag or set it to external.
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Ecommerce network policy is fail-closed: domestic sites stay direct.
# Set true only when a dedicated Amazon proxy channel is actually provisioned.
# POLARIS_ECOMMERCE_PROXY_ENABLED=false
# Optional: keep 1688 login state in its own profile; never reuse the Taobao profile.
# POLARIS_ECOMMERCE_1688_SESSION_DIR=backend/.data/ecommerce-session/domestic-1688
# Optional: keep JD login state in its own profile; never reuse Taobao or 1688 profiles.
# POLARIS_ECOMMERCE_JD_SESSION_DIR=backend/.data/ecommerce-session/domestic-jd

# Optional local-only real image-provider testing. Keep these commented until
# a real Tengli key is available; never use a placeholder key.
# POLARIS_TASK_RUNNER=tengli
# POLARIS_REFERENCE_REMIX_PROVIDER_ENABLED=true
# POLARIS_CREATIVE_IMAGE_PROVIDER_ENABLED=true
# POLARIS_TENGLI_API_KEY=replace-with-a-real-key
# POLARIS_TENGLI_BASE_URL=https://api.tengliapi.xyz:8443
# POLARIS_TENGLI_VISION_MODEL=gpt-5.6-terra
# POLARIS_TENGLI_IMAGE_MODEL=gpt-image-2

# Aurora remains on the current sequential production path until v2.0 is accepted.
POLARIS_AURORA_EXECUTION_MODE=sequential_v017
POLARIS_AURORA_MAX_TRANSIENT_RETRIES=2
POLARIS_AURORA_RETRY_BACKOFF_BASE_SECONDS=2
POLARIS_AURORA_RETRY_BACKOFF_MAX_SECONDS=30

# L1: audit generated pages with the Skill's own pixel-audit rubric.
# When enabled, the domestic main-image reviewer receives the full text of
# `skill_sources/aurora-domestic-ecommerce-main-image-v20/references/visual-audit.md`
# plus the user's own fact pool, instead of the shipped prompt alone.  Generation,
# planning and persistence are unchanged.  Default: off, so the shipped audit
# prompt and contract stay byte-identical until a shadow run is measured.
# POLARIS_AURORA_L1_RUBRIC_ENABLED=false
# L2: pass the original Skill references through planning, generation and repair
# in the domestic-main-image shadow channel. Default: off.
# POLARIS_AURORA_L2_REFERENCE_ENABLED=false

# P-7: allow an incomplete domestic main image set to be downloaded anyway.
# The archive packs every page that already produced a deliverable and adds a
# manifest.json listing the missing pages and their failure reasons.  Both flags
# must be flipped together: the API flag enforces the endpoint, the frontend
# flag decides whether the download entry point is rendered.  Default: off.
# POLARIS_DOMESTIC_PARTIAL_ARCHIVE_ENABLED=false
# NEXT_PUBLIC_POLARIS_DOMESTIC_PARTIAL_ARCHIVE=false
