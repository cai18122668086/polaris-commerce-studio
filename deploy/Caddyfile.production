{
	admin off
	email {$POLARIS_ACME_EMAIL}
}

jgshai.cn {
	redir https://www.jgshai.cn{uri} permanent
}

www.jgshai.cn {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8765/v1/enrollment http://127.0.0.1:8765/v1/enrollment; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	@api {
		path /api/* /health/*
		not path /api/v1/workspaces/*/assets/*/content
	}
	header @api Cache-Control "no-store"

	@immutable path /_polaris-static/* /assets/* /images/display/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Signed private asset responses carry their own short-lived cache policy;
	# keep the API no-store rule from defeating ETag reuse for image reloads.
	@private_asset path /api/v1/workspaces/*/assets/*/content
	handle @private_asset {
		# Overwrite, never append: the client cannot inject a hop the API trusts.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Ecommerce login state is per-process; keep it on the single-process API.
	@ecommerce path /api/ecommerce /api/ecommerce/*
	handle @ecommerce {
		# Overwrite, never append: the client cannot inject a hop the API trusts.
		reverse_proxy ecommerce-api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle @api {
		# Overwrite, never append: the client cannot inject a hop the API trusts.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
