FROM python:3.12.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md editing-constraints.txt ./
COPY app ./app
COPY scripts ./scripts
RUN python -m pip install torch==2.5.1+cpu torchaudio==2.5.1+cpu --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install -c editing-constraints.txt '.[editing,editing-zh]' \
    && python -m playwright install --with-deps chromium \
    && python -m pip check

RUN groupadd --system --gid 10001 polaris \
    && useradd --system --uid 10001 --gid polaris --home-dir /app polaris \
    && mkdir -p /app/.data/editing-tasks \
    && chown -R polaris:polaris /app /ms-playwright

USER 10001:10001
CMD ["python", "-m", "celery", "-A", "app.celery_app:celery_app", "worker", "--queues=editing", "--concurrency=1", "--loglevel=INFO"]
